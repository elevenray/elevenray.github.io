<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.title }}</title>
<meta name="description" content="{{ site.tagline }}">
<link rel="icon" type="image/x-icon" href="{{ static_prefix }}static/images/favicon.ico">
<link rel="icon" type="image/png" sizes="16x16" href="{{ static_prefix }}static/images/favicon-16x16.png">
<link rel="icon" type="image/png" sizes="32x32" href="{{ static_prefix }}static/images/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="48x48" href="{{ static_prefix }}static/images/favicon-48x48.png">
<link rel="apple-touch-icon" href="{{ static_prefix }}static/images/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ static_prefix }}static/css/style.css?v={{ asset_version.css }}">
</head>
<body>

<a class="back-to-portfolio" href="../">&larr; Back to the boring portfolio</a>

<header class="intro">
  <h1>{{ site.name }}</h1>
  <p class="portal-name" id="portal-name" aria-live="polite"></p>
  <p class="hint hint--keys">WASD or arrow keys to move &middot; Enter or Space to step through a portal</p>
  <p class="hint hint--touch">Drag the floor to walk &middot; tap a portal to enter, tap Back to return</p>
</header>

<main class="dungeon" id="dungeon">
  <div class="dungeon-frame">
    <div class="dungeon-room" id="room-floor">
      <div class="floor-surface" aria-hidden="true"></div>
      <div class="side-wall side-wall--left" aria-hidden="true"></div>
      <div class="side-wall side-wall--right" aria-hidden="true"></div>
      <div class="back-wall" aria-hidden="true"></div>

      <div class="wall-torch" style="left: 20%;" aria-hidden="true"></div>
      <div class="wall-torch" style="left: 40%;" aria-hidden="true"></div>
      <div class="wall-torch" style="left: 60%;" aria-hidden="true"></div>
      <div class="wall-torch" style="left: 80%;" aria-hidden="true"></div>

      <div class="cave-prop cave-prop--katana" id="easter-katana" aria-hidden="true"></div>
      <div class="cave-prop cave-prop--kabuto" id="easter-kabuto" aria-hidden="true"></div>
      <div class="cave-prop cave-prop--chest" id="easter-chest" aria-hidden="true"></div>
      <div class="cave-prop cave-prop--gold" id="easter-gold" aria-hidden="true"></div>
      <div class="cave-prop cave-prop--barrel" id="easter-barrel" aria-hidden="true"></div>

      <div class="floor-message" id="floor-message" aria-live="polite">
        <span class="floor-message-text" id="floor-message-text"></span>
      </div>

      {% for frame in frames %}
      <button
        class="portal"
        id="{{ frame.id }}"
        data-target="room-{{ frame.id }}"
        data-title="{{ frame.company }}"
        data-role="{{ frame.role }}"
        style="--accent: {{ frame.portal_color }}; left: {{ frame.portal_x }}%; top: {{ frame.portal_y }}%;"
        aria-label="Enter {{ frame.company }}"
      >
        <span class="portal-arch" style="background-image: url('{{ static_prefix }}{{ frame.archway }}');"></span>
      </button>
      {% endfor %}

      <div class="player" id="player">
        <img class="player-sprite" id="player-sprite" src="{{ static_prefix }}static/images/visitor/south-static.png" alt="">
      </div>

      <div class="interact-hint" id="interact-hint" aria-hidden="true">
        <kbd>Enter</kbd><span class="interact-hint-touch">tap</span>
      </div>
    </div>
  </div>

  <div class="touch-controls" id="touch-controls" aria-hidden="true">
    <button class="touch-btn touch-btn--interact" id="touch-interact" aria-label="Interact with nearest portal">&#9166;</button>
  </div>
</main>

{% for frame in frames %}
<section class="room" id="room-{{ frame.id }}" style="--accent: {{ frame.portal_color }};">
  <button class="room-back" aria-label="Back to the dungeon">&larr; Back</button>
  <div class="room-content">
    {% if frame.image %}
    <img class="room-avatar" src="{{ static_prefix }}{{ frame.image }}" alt="{{ frame.company }}">
    {% endif %}
    <p class="room-period">{{ frame.period }}</p>
    <h2>{{ frame.company }}</h2>
    {% if frame.role %}<h3>{{ frame.role }}</h3>{% endif %}
    <p class="room-summary">{{ frame.summary }}</p>
    <p class="room-description">{{ frame.description }}</p>
    {% if frame.tags %}
    <ul class="room-tags">
      {% for tag in frame.tags %}<li>{{ tag }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if frame.achievements %}
    <ul class="room-achievements">
      {% for a in frame.achievements %}<li>{{ a }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if frame.link %}
    <a class="room-link" href="{{ frame.link }}" target="_blank" rel="noopener">{{ frame.link_label }}</a>
    {% endif %}
  </div>
</section>
{% endfor %}

<div class="vignette" id="vignette" aria-hidden="true"></div>

<div class="toast" id="chest-toast" role="status" aria-live="polite">
  <span class="toast-icon" aria-hidden="true">&#10024;</span>
  <span class="toast-text" id="chest-toast-text">Pantry app coming soon</span>
</div>

<div class="big-sign" id="big-sign" role="status" aria-live="polite">
  <span class="big-sign-text" id="big-sign-text"></span>
</div>

<footer class="site-footer">
  <p>&copy; {{ year }} {{ site.name }} &middot; {{ site.footer_note }} &middot; <a href="mailto:{{ site.email }}">{{ site.email }}</a> &middot; <a href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener">GitHub</a></p>
</footer>

<script>window.STATIC_BASE = "{{ static_prefix }}";</script>
<script src="{{ static_prefix }}static/js/dungeon.js?v={{ asset_version.js }}"></script>
</body>
</html>
